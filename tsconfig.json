{
        "extends": "@tsconfig/node24/tsconfig.json",
        "compilerOptions": {
                "customConditions": [
                        "node"
                ],
                "module": "ES2022",
                "moduleResolution": "Bundler",
                "noImplicitOverride": true,
                "allowImportingTsExtensions": true,
                "rewriteRelativeImportExtensions": true,
        },
        "include": [
                "src/**/*.ts"
        ],
        "exclude": [
                "node_modules"
        ]
}
