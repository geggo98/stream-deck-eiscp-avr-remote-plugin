{
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart de.schwetschke.sd.eiscp-avr-remote\"",
    "test": "node --test tests/**/*.test.ts",
    "test:unit": "node --test tests/**/*.test.ts",
    "test:eiscp": "node --test tests/eiscp-*.test.ts",
    "test:eiscp:integration": "node --test tests/eiscp-integration.test.ts",
    "discover-airplay": "tsx scripts/discover-airplay.ts",
    "eiscp": "tsx scripts/eiscp-cli.ts",
    "discover-eiscp-broadcast": "tsx scripts/discover-eiscp-broadcast.ts",
    "discover-eiscp-ip-scan": "tsx scripts/discover-eiscp-ip-scan.ts",
    "discover-all": "tsx scripts/discover-all.ts",
    "dummy:discovery": "tsx scripts/dummy-eiscp-discovery.ts",
    "generate:commands": "tsx scripts/generate-command-registry.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "generate": "npm run generate:commands && npm run generate:icons && npm run generate:manifest",
    "capture:responses": "tsx scripts/capture-command-responses.ts"
  },
  "type": "module",
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~20.15.0",
    "lucide-static": "^1.17.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0"
  }
}
