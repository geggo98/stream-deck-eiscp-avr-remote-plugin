        {
          "Image": "imgs/actions/eiscp-dial-indicator/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Press action",
          "Rotate": "Adjust"
        }
      }
    },
