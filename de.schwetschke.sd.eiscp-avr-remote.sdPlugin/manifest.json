{
  "Name": "eISCP AV Receiver Remote Control",
  "UUID": "de.schwetschke.sd.eiscp-avr-remote",
  "Version": "1.0.2.0",
  "Author": "Stefan Schwetschke",
  "URL": "https://github.com/geggo98/stream-deck-eiscp-avr-remote-plugin",
  "Description": "Remote control for AV receivers that support the Integra Serial Control Protocol over Ethernet (eISCP). Compatible with many Pioneer, Onkyo and Integra network receivers. Independent project, not affiliated with or endorsed by these manufacturers.",
  "Icon": "imgs/plugin/marketplace",
  "Category": "eISCP AV Receiver Remote Control",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "eISCP Button",
      "UUID": "de.schwetschke.sd.eiscp-avr-remote.eiscp-button",
      "Icon": "imgs/actions/eiscp-button/icon",
      "Tooltip": "Send any eISCP command. Use for one-shot commands, volume up/down, etc.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/eiscp-button.html",
      "States": [
        {
          "Image": "imgs/actions/eiscp-button/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "eISCP Toggle",
      "UUID": "de.schwetschke.sd.eiscp-avr-remote.eiscp-toggle",
      "Icon": "imgs/actions/eiscp-toggle/icon",
      "Tooltip": "Toggle on/off eISCP commands. Use for power, mute, direct mode, etc.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/eiscp-toggle.html",
      "States": [
        {
          "Name": "Off",
          "Image": "imgs/actions/eiscp-toggle/key",
          "TitleAlignment": "middle"
        },
        {
          "Name": "On",
          "Image": "imgs/actions/eiscp-toggle/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "eISCP Dial Value",
      "UUID": "de.schwetschke.sd.eiscp-avr-remote.eiscp-dial",
      "Icon": "imgs/actions/eiscp-dial/icon",
      "Tooltip": "Encoder for text-based eISCP values. Use for input selector, listening mode, etc.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/eiscp-dial.html",
      "States": [
        {
          "Image": "imgs/actions/eiscp-dial/key",
          "TitleAlignment": "middle"
        }
      ],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Push": "Press action",
          "Rotate": "Adjust"
        }
      }
    },
    {
      "Name": "eISCP Dial Indicator",
      "UUID": "de.schwetschke.sd.eiscp-avr-remote.eiscp-dial-indicator",
      "Icon": "imgs/actions/eiscp-dial-indicator/icon",
