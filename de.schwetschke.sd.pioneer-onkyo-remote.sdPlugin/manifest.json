{
  "Name": "Pioneer and Onkyo Receiver Network Remote",
  "UUID": "de.schwetschke.sd.pioneer-onkyo-remote",
  "Version": "0.1.0.0",
  "Author": "Stefan Schwetschke",
  "Description": "Remote control for receivers which support ISCP (Integra Serial Control Protocol) over Ethernet (eISCP) protocol",
  "Icon": "imgs/plugin/marketplace",
  "Category": "Pioneer and Onkyo Receiver Network Remote",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Debug": "enabled",
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Counter",
      "UUID": "de.schwetschke.sd.pioneer-onkyo-remote.increment",
      "Icon": "imgs/actions/counter/icon",
      "Tooltip": "Displays a count, which increments by one on press.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/increment-counter.html",
      "States": [
        {
          "Image": "imgs/actions/counter/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Power Control",
      "UUID": "de.schwetschke.sd.pioneer-onkyo-remote.power-control",
      "Icon": "assets/actions/power-control/icon",
      "PropertyInspectorPath": "assets/actions/power-control/pi.html",
      "States": [
        {
          "Image": "assets/actions/power-control/state0"
        }
      ]
    },
    {
      "Name": "eISCP Button",
      "UUID": "de.schwetschke.sd.pioneer-onkyo-remote.eiscp-button",
      "Icon": "imgs/actions/counter/icon",
      "Tooltip": "Send any eISCP command. Use for volume up/down, input selection, etc.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/eiscp-button.html",
      "States": [
        {
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "eISCP Toggle",
      "UUID": "de.schwetschke.sd.pioneer-onkyo-remote.eiscp-toggle",
      "Icon": "imgs/actions/counter/icon",
      "Tooltip": "Toggle on/off eISCP commands. Use for power, mute, direct mode, etc.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/eiscp-toggle.html",
      "States": [
        {
          "TitleAlignment": "middle",
          "Name": "Off"
        },
        {
          "TitleAlignment": "middle",
          "Name": "On"
        }
      ]
    },
    {
      "Name": "eISCP Dial",
      "UUID": "de.schwetschke.sd.pioneer-onkyo-remote.eiscp-dial",
      "Icon": "imgs/actions/counter/icon",
      "Tooltip": "Encoder control for eISCP commands. Use for volume, input cycling, etc.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/eiscp-dial.html",
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust",
          "Push": "Press action"
        }
      },
      "States": [
        {}
      ]
    }
  ],
  "SDKVersion": 3
}
